@model ShoppingCartViewModel
@{
    ViewData["Title"] = "Your Shopping Bag";
    var canOrderOnWhatsApp = Model.Items.Count > 0 && Model.Items.All(item => item.IsAvailable);
    var itemLabel = Model.Items.Count == 1 ? "1 item" : $"{Model.Items.Count} items";
    var unitLabel = Model.ItemCount == 1 ? "1 total unit" : $"{Model.ItemCount} total units";
    string FormatPrice(decimal value, string currency) => currency.Equals("INR", StringComparison.OrdinalIgnoreCase)
        ? $"\u20B9{value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))}"
        : $"{value:N2} {currency}";
}

<main class="cart-page">
    <div class="container">
        <nav class="cart-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Shopping Bag</span>
        </nav>

        <header class="cart-heading">
            <div>
                <p class="eyebrow">AARCHIZZ</p>
                <h1>Your Shopping Bag</h1>
            </div>
            <p class="cart-heading__count">@itemLabel</p>
        </header>

        @if (Model.Items.Count == 0)
        {
            <section class="cart-empty" aria-labelledby="cart-empty-title">
                <div class="cart-empty__icon" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none"><path d="M10 17h28l2.5 25h-33L10 17Z" stroke="currentColor" stroke-width="1.5"/><path d="M17 18v-4a7 7 0 0 1 14 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <h2 id="cart-empty-title">Your bag is waiting for something special.</h2>
                <p>Take a look through the collection and find a piece to make your own.</p>
                <a class="button button--dark" asp-controller="Shop" asp-action="Index">Continue Shopping <span aria-hidden="true">&rarr;</span></a>
            </section>
        }
        else
        {
            <div class="cart-layout">
                <section class="cart-items" aria-label="Items in your shopping bag">
                    @foreach (var item in Model.Items)
                    {
                        <article class="cart-item">
                            <a class="cart-item__image-link" asp-controller="Shop" asp-action="Details" asp-route-slug="@item.Slug" aria-label="View @item.Name">
                                <img class="cart-item__image" src="@item.ImageUrl" alt="@item.Name" />
                            </a>
                            <div class="cart-item__details">
                                <p class="cart-item__brand">AARCHIZZ</p>
                                <h2><a asp-controller="Shop" asp-action="Details" asp-route-slug="@item.Slug">@item.Name</a></h2>
                                @if (!string.IsNullOrWhiteSpace(item.VariantLabel))
                                {
                                    <p class="cart-item__variant">Color / option: @item.VariantLabel</p>
                                }
                                <p class="cart-item__price">@FormatPrice(item.UnitPrice, item.CurrencyCode) <span>each</span></p>
                                <p class="cart-item__availability @(item.IsAvailable ? "" : "cart-item__availability--warning")" role="status">
                                    @(item.IsAvailable ? "In stock" : item.AvailabilityMessage)
                                </p>
                            </div>
                            <div class="cart-item__actions">
                                @if (item.CanAdjustQuantity)
                                {
                                    <form asp-controller="Cart" asp-action="Update" method="post" class="cart-quantity-form" aria-label="Quantity for @item.Name">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="variantId" value="@item.VariantId" />
                                        <button class="cart-stepper__button" type="button" data-quantity-step="-1" aria-label="Decrease quantity" disabled="@(item.Quantity <= 1)">&#8722;</button>
                                        <input class="cart-stepper__input" type="number" name="quantity" value="@item.Quantity" min="1" max="@Math.Max(item.Quantity, item.AvailableQuantity)" inputmode="numeric" required aria-label="Quantity for @item.Name" />
                                        <button class="cart-stepper__button" type="button" data-quantity-step="1" aria-label="Increase quantity" disabled="@(item.Quantity >= item.AvailableQuantity)">+</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="cart-item__quantity">Quantity: @item.Quantity</span>
                                }
                                <div class="cart-item__total-block">
                                    <span>Line total</span>
                                    <strong class="cart-item__total">@FormatPrice(item.LineTotal, item.CurrencyCode)</strong>
                                </div>
                                <form asp-controller="Cart" asp-action="Remove" method="post" class="cart-item__remove-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="variantId" value="@item.VariantId" />
                                    <button type="submit" class="cart-text-button" aria-label="Remove @item.Name from your shopping bag">Remove</button>
                                </form>
                            </div>
                        </article>
                    }
                </section>

                <aside class="cart-summary" aria-labelledby="cart-summary-title">
                    <p class="cart-summary__eyebrow">Your order</p>
                    <h2 id="cart-summary-title">Order Summary</h2>
                    <div class="cart-summary__row">
                        <span>Subtotal</span>
                        @if (!string.IsNullOrWhiteSpace(Model.CurrencyCode))
                        {
                            <strong>@FormatPrice(Model.Subtotal, Model.CurrencyCode)</strong>
                        }
                        else
                        {
                            <strong class="cart-summary__mixed">See item totals</strong>
                        }
                    </div>
                    <p class="cart-summary__units">@itemLabel &middot; @unitLabel in your bag</p>
                    <p class="cart-summary__note">Shipping charges, if applicable, will be confirmed by the store. Subtotal does not include shipping.</p>

                    <hr class="cart-summary__divider" />
                    <form asp-controller="Cart" asp-action="OrderOnWhatsApp" method="post" target="_blank" class="cart-whatsapp-form">
                        @Html.AntiForgeryToken()
                        <button class="button button--whatsapp" type="submit" disabled="@(!canOrderOnWhatsApp)" aria-describedby="whatsapp-order-help">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.8a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-4.9a8.4 8.4 0 1 1 16.1-3.8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 8.1c.2-.5.4-.5.7-.5h.5c.2 0 .3.1.4.4l.7 1.6c.1.2.1.4-.1.6l-.5.6c-.2.2-.2.3-.1.5.3.6 1 1.5 1.8 2 .5.3 1 .5 1.3.5.2 0 .3 0 .5-.2l.7-.8c.2-.2.3-.2.6-.1l1.5.7c.3.1.4.2.4.4 0 .2-.1 1-.6 1.4-.5.5-1.2.7-1.9.6-.7-.1-1.6-.4-2.7-1-1.4-.8-2.4-2.1-2.8-2.7-.4-.6-1-1.5-1-2.3 0-.8.4-1.4.6-1.7Z" fill="currentColor"/></svg>
                            Order on WhatsApp <span aria-hidden="true">&#8599;</span>
                        </button>
                    </form>
                    <p class="cart-summary__note cart-summary__help @(canOrderOnWhatsApp ? "" : "cart-summary__warning")" id="whatsapp-order-help">
                        @if (canOrderOnWhatsApp)
                        {
                            @:Review and send your enquiry in WhatsApp. No order is placed until you send it and the store confirms it.
                        }
                        else
                        {
                            @:Update quantities or remove unavailable items before ordering on WhatsApp.
                        }
                    </p>
                    <a class="button button--light cart-continue" asp-controller="Shop" asp-action="Index"><span aria-hidden="true">&larr;</span> Continue Shopping</a>
                </aside>
            </div>
        }
    </div>
</main>
@section Scripts {
    <script>
        document.querySelectorAll('.cart-quantity-form').forEach(form => {
            const quantity = form.querySelector('.cart-stepper__input');
            const buttons = form.querySelectorAll('[data-quantity-step]');
            const updateButtons = () => {
                const value = Number(quantity.value);
                const min = Number(quantity.min);
                const max = Number(quantity.max);
                buttons.forEach(button => {
                    const step = Number(button.dataset.quantityStep);
                    button.disabled = !Number.isInteger(value) || value + step < min || value + step > max;
                });
            };

            buttons.forEach(button => button.addEventListener('click', () => {
                const current = Number(quantity.value);
                const next = current + Number(button.dataset.quantityStep);
                const min = Number(quantity.min);
                const max = Number(quantity.max);
                if (!Number.isInteger(next) || next < min || next > max) return;
                quantity.value = String(next);
                updateButtons();
                form.requestSubmit();
            }));

            quantity.addEventListener('change', () => {
                const value = Number(quantity.value);
                const min = Number(quantity.min);
                const max = Number(quantity.max);
                if (!Number.isInteger(value) || value < min || value > max) {
                    quantity.value = String(Math.max(min, Math.min(max, Number.isFinite(value) ? value : min)));
                    updateButtons();
                    return;
                }
                form.requestSubmit();
            });

            form.addEventListener('submit', () => buttons.forEach(button => button.disabled = true));
            updateButtons();
        });
    </script>
}
