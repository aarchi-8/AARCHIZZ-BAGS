@model AARCHIZZ.Models.AdminCategoryFormViewModel
@{
  ViewData["Title"] = "Create category";
}
<main class="admin-products-page">
  <div class="container admin-products"><a class="admin-auth-back" asp-controller="AdminCategories"
                                             asp-action="Index">&larr; Back to categories</a>
    <section class="admin-create-panel">
      <p class="eyebrow">Catalogue management</p>
      <h1>Create category</h1>
      <p class="admin-auth-intro">Add a category for your database catalogue. Leave the slug blank to generate one from
        the name.</p>
        <form asp-controller="AdminCategories" asp-action="Create" method="post" enctype="multipart/form-data" class="admin-product-form">
          <div asp-validation-summary="ModelOnly" class="admin-form__error" role="alert"></div>
          <div class="admin-product-form__grid">
            <div class="admin-form__field"><label asp-for="Name"></label><input asp-for="Name" autofocus /><span
              asp-validation-for="Name"></span></div>
              <div class="admin-form__field"><label asp-for="Slug"></label><input asp-for="Slug" /><span
                asp-validation-for="Slug"></span></div>
                <div class="admin-form__field admin-product-form__wide"><label asp-for="Description"></label><textarea
                  asp-for="Description" rows="4"></textarea><span asp-validation-for="Description"></span></div>
                  <div class="admin-form__field admin-product-form__wide"><partial name="_CategoryImageUpload" model="Model" /></div>
                    <div class="admin-form__field admin-product-form__checkbox"><input asp-for="IsPublished" /><label
                      asp-for="IsPublished"></label></div>
                    </div><button class="button button--dark admin-form__submit" type="submit">Create category <span
                    aria-hidden="true">&rarr;</span></button>
                  </form>
                </section>
              </div>
            </main>
            @section Scripts {
              <partial name="_ValidationScriptsPartial" />
              <script src="~/js/admin-category-image.js" asp-append-version="true"></script>
            }
