@model AARCHIZZ.Models.AdminCategoryListViewModel
@{
  ViewData["Title"] = "Categories";
}
<main class="admin-products-page">
  <div class="container admin-products">
    <div class="admin-products__header">
      <div>
        <p class="eyebrow">Catalogue management</p>
        <h1>Categories</h1>
        <p>Organize the published catalogue without editing code.</p>
      </div><a class="button button--dark" asp-controller="AdminCategories" asp-action="Create">Create category <span
      aria-hidden="true">&rarr;</span></a>
    </div>
    @if (TempData["AdminCategoryMessage"] is string message)
    {
      <div class="admin-form__success" role="status">@message
      </div>
    }
    @if (TempData["AdminCategoryError"] is string error)
    {
      <div class="admin-form__error" role="alert">@error</div>
    }
    @if (Model.Categories.Count == 0)
    {
      <section class="admin-empty">
        <p class="eyebrow">No categories yet</p>
        <h2>Your catalogue starts here.</h2>
        <p>Create a category before adding products.</p><a class="button button--dark" asp-controller="AdminCategories"
                                                           asp-action="Create">Create category <span aria-hidden="true">&rarr;</span></a>
      </section>
    }
    else
    {

      <div class="admin-product-table-wrap">
        <table class="admin-product-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Slug</th>
              <th>Description</th>
              <th>Products</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>@foreach (var category in Model.Categories) {
            <tr>
              <td><strong>@category.Name</strong></td>
              <td>@category.Slug</td>
              <td>@(category.Description ?? "-")</td>
              <td>@category.Products.Count</td>
              <td><span
                class="admin-status @(category.IsPublished ? "admin-status--published" : "admin-status--draft")">@(category.IsPublished
                  ? "Published" : "Unpublished")</span></td>
                <td class="admin-product-actions"><a asp-controller="AdminCategories" asp-action="Edit"
                                                       asp-route-id="@category.Id">Edit</a><a asp-controller="AdminCategories" asp-action="Delete"
                                                         asp-route-id="@category.Id">Delete</a>
                  <form asp-controller="AdminCategories" asp-action="@(category.IsPublished ? "Unpublish" : "Publish")"
                        asp-route-id="@category.Id" method="post"><button type="submit">@(category.IsPublished ? "Unpublish" :
                        "Publish")</button></form>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </main>