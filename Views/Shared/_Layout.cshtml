<!DOCTYPE html>
@inject ShoppingCartSessionStore CartSessionStore
@inject WhatsAppOrderService WhatsAppOrderService
@inject Microsoft.Extensions.Options.IOptions<StoreOptions> StoreOptions
@{
    var cartCount = CartSessionStore.GetCount(Context.Session);
    var hasFooterWhatsAppLink = WhatsAppOrderService.TryCreateContactLink(out var footerWhatsAppLink, out _);
    var storeLocationUrl = StoreOptions.Value.LocationUrl;
}
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | AARCHIZZ BAGS</title>
    @if (ViewData["MetaDescription"] is string metaDescription && !string.IsNullOrWhiteSpace(metaDescription)) { <meta name="description" content="@metaDescription" /> }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AARCHIZZ.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <div class="container site-header__inner">
            <button class="menu-toggle" type="button" aria-controls="site-navigation"
                    aria-expanded="false"><span></span><span></span><span></span><span class="visually-hidden">Open
                menu</span></button>
                <a class="wordmark" asp-area="" asp-controller="Home" asp-action="Index"
                   aria-label="AARCHIZZ BAGS home">AARCHIZZ BAGS</a>
                <nav class="site-nav" id="site-navigation" aria-label="Main navigation">
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Shop" asp-action="Index">Shop All</a>
                    <a asp-controller="Collections" asp-action="Index">Collections</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="about">About Us</a>
                </nav>
                <div class="site-actions">
                    <button class="icon-link search-toggle" type="button" aria-expanded="false" aria-controls="search-panel"
                            title="Search coming soon"><span class="icon icon--search" aria-hidden="true"></span><span
                        class="icon-label">Search</span></button>
                            <a class="icon-link cart-nav-link" asp-controller="Cart" asp-action="Index" title="Shopping bag">
                                <span class="icon icon--bag" aria-hidden="true"></span><span class="icon-label">Bag</span>
                                <span class="cart-nav-count" aria-label="@cartCount items in bag">@cartCount</span>
                            </a>
                            </div>
                        </div>
                        <div class="search-panel" id="search-panel" hidden>
                            <div class="container">
                                <form class="search-form" asp-controller="Shop" asp-action="Index" method="get"><label
                                    for="site-search">Search the collection</label>
                                    <div><input id="site-search" name="search" type="search" placeholder="Try “shoulder bag”" /><button
                                        type="submit">Search</button></div>
                                    </form>
                                </div>
                            </div>
                        </header>
                        @if (TempData["CartMessage"] is string cartMessage)
                        {
                            <p class="cart-flash" role="status">@cartMessage</p>
                        }
                        @if (TempData["CartError"] is string cartError)
                        {
                            <p class="cart-flash cart-flash--error" role="alert">@cartError</p>
                        }
                        @RenderBody()

                        <footer class="site-footer">
                            <div class="container site-footer__top">
                                <div class="site-footer__brand"><a class="wordmark wordmark--footer" asp-area="" asp-controller="Home"
                                                                       asp-action="Index">AARCHIZZ BAGS</a>
                                    <p>Thoughtful bags for every version of you. Designed with intention, carried with confidence.</p>
                                </div>
                                <div class="footer-column">
                                        <h2>Explore</h2>
                                        <a asp-controller="Shop" asp-action="Index">Shop All</a>
                                        <a asp-controller="Shop" asp-action="Index" asp-route-sort="featured">Featured</a>
                                        <a asp-controller="Collections" asp-action="Index">Collections</a>
                                </div>
                                <div class="footer-column">
                                        <h2>Contact &amp; Visit</h2>
                                        @if (hasFooterWhatsAppLink)
                                        {
                                            <a class="footer-contact-link" href="@footerWhatsAppLink" target="_blank" rel="noopener noreferrer"><span class="footer-contact-icon" aria-hidden="true">&#9742;</span>Contact Us</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(storeLocationUrl))
                                        {
                                            <a class="footer-contact-link" href="@storeLocationUrl" target="_blank" rel="noopener noreferrer"><span class="footer-contact-icon" aria-hidden="true">&#128205;</span>Visit Our Store</a>
                                        }
                                </div>
                                <div class="footer-column">
                                    <h2>Customer Care</h2>
                                    <a asp-area="" asp-controller="Home" asp-action="ShippingReturns">Shipping &amp; Returns</a>
                                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </div>
                            </div>
                            <div class="container site-footer__bottom"><span>&copy; 2026 AARCHIZZ BAGS. All rights
                                reserved.</span><span>Designed for the everyday extraordinary.</span></div>
                            </footer>
                            <script src="~/js/site.js" asp-append-version="true"></script>
                            @await RenderSectionAsync("Scripts", required: false)
                        </body>

                    </html>
