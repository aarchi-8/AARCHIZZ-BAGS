@model AARCHIZZ.Models.AdminProductCreateViewModel
@{
  var categories = ViewBag.Categories as IReadOnlyList<AARCHIZZ.Data.Entities.Category> ?? [];
  var edit = Model is AARCHIZZ.Models.AdminProductEditViewModel;
  var editModel = Model as AARCHIZZ.Models.AdminProductEditViewModel;
}
<div asp-validation-summary="ModelOnly" class="admin-form__error" role="alert"></div>
<section class="admin-product-section"><h2>Basic Information</h2><div class="admin-product-form__grid">
<div class="admin-form__field"><label asp-for="Name"></label><input asp-for="Name" autofocus/><span asp-validation-for="Name"></span></div>
<div class="admin-form__field"><label asp-for="Slug"></label><input asp-for="Slug" placeholder="Leave blank to generate from product name"/><span asp-validation-for="Slug"></span></div>
<div class="admin-form__field"><label asp-for="Sku"></label><input asp-for="Sku"/><span asp-validation-for="Sku"></span></div>
<div class="admin-form__field"><label asp-for="Barcode"></label><input asp-for="Barcode"/><span asp-validation-for="Barcode"></span></div>
<div class="admin-form__field"><label asp-for="CategoryId"></label><select asp-for="CategoryId"><option value="">Select a category</option>@foreach (var category in categories.OrderBy(c=>c.Name)) { <option value="@category.Id">@category.Name</option> }</select><span asp-validation-for="CategoryId"></span></div>
<div class="admin-form__field"><label asp-for="Brand"></label><input asp-for="Brand"/><span asp-validation-for="Brand"></span></div>
<div class="admin-form__field"><label asp-for="StyleCode"></label><input asp-for="StyleCode"/><span asp-validation-for="StyleCode"></span></div>
<div class="admin-form__field"><label asp-for="ProductType"></label><input asp-for="ProductType" placeholder="Tote, crossbody, shoulder bag"/><span asp-validation-for="ProductType"></span></div>
<div class="admin-form__field"><label asp-for="Tags"></label><input asp-for="Tags"/><span asp-validation-for="Tags"></span></div>
<div class="admin-form__field admin-product-form__wide"><label asp-for="ShortDescription"></label><textarea asp-for="ShortDescription" rows="2"></textarea><span asp-validation-for="ShortDescription"></span></div>
<div class="admin-form__field admin-product-form__wide"><label asp-for="Description">Full description</label><textarea asp-for="Description" rows="5"></textarea><span asp-validation-for="Description"></span></div></div></section>
<section class="admin-product-section"><h2>Pricing &amp; Inventory</h2><div class="admin-product-form__grid">
<div class="admin-form__field"><label asp-for="Price">Regular price (INR)</label><input asp-for="Price" type="number" min="0" step="0.01"/><span asp-validation-for="Price"></span></div><div class="admin-form__field"><label asp-for="SalePrice">Sale price (INR, optional)</label><input asp-for="SalePrice" type="number" min="0.01" step="0.01"/><span asp-validation-for="SalePrice"></span></div>
<div class="admin-form__field"><label asp-for="StockQuantity"></label><input asp-for="StockQuantity" type="number" min="0"/><span asp-validation-for="StockQuantity"></span></div><div class="admin-form__field"><label asp-for="LowStockThreshold"></label><input asp-for="LowStockThreshold" type="number" min="0"/><span asp-validation-for="LowStockThreshold"></span></div></div></section>
<section class="admin-product-section"><h2>Bag Specifications</h2><div class="admin-product-form__grid">
<div class="admin-form__field"><label asp-for="Material">Outer material</label><input asp-for="Material"/><span asp-validation-for="Material"></span></div><div class="admin-form__field"><label asp-for="LiningMaterial"></label><input asp-for="LiningMaterial"/><span asp-validation-for="LiningMaterial"></span></div><div class="admin-form__field"><label asp-for="Color">Primary color (variants can list more)</label><input asp-for="Color"/><span asp-validation-for="Color"></span></div>
<div class="admin-form__field"><label asp-for="Pattern"></label><input asp-for="Pattern"/><span asp-validation-for="Pattern"></span></div><div class="admin-form__field"><label asp-for="Finish"></label><input asp-for="Finish"/><span asp-validation-for="Finish"></span></div>
<div class="admin-form__field"><label asp-for="Height"></label><input asp-for="Height" type="number" min="0.001" step="0.001"/><span asp-validation-for="Height"></span></div><div class="admin-form__field"><label asp-for="Width"></label><input asp-for="Width" type="number" min="0.001" step="0.001"/><span asp-validation-for="Width"></span></div><div class="admin-form__field"><label asp-for="Length">Depth / length</label><input asp-for="Length" type="number" min="0.001" step="0.001"/><span asp-validation-for="Length"></span></div><div class="admin-form__field"><label asp-for="DimensionUnit"></label><input asp-for="DimensionUnit" placeholder="cm, in"/><span asp-validation-for="DimensionUnit"></span></div><div class="admin-form__field"><label asp-for="Dimensions">Additional dimensions / notes</label><input asp-for="Dimensions"/><span asp-validation-for="Dimensions"></span></div>
<div class="admin-form__field"><label asp-for="Weight"></label><input asp-for="Weight" type="number" min="0.001" step="0.001"/><span asp-validation-for="Weight"></span></div><div class="admin-form__field"><label asp-for="WeightUnit"></label><input asp-for="WeightUnit" placeholder="g, kg"/><span asp-validation-for="WeightUnit"></span></div><div class="admin-form__field"><label asp-for="ClosureType"></label><input asp-for="ClosureType"/><span asp-validation-for="ClosureType"></span></div><div class="admin-form__field"><label asp-for="HandleStrapType">Handle / strap type and adjustability</label><input asp-for="HandleStrapType" placeholder="For example: top handle, adjustable shoulder strap"/><span asp-validation-for="HandleStrapType"></span></div>
<div class="admin-form__field"><label asp-for="CompartmentCount"></label><input asp-for="CompartmentCount" type="number" min="0"/></div><div class="admin-form__field"><label asp-for="PocketCount"></label><input asp-for="PocketCount" type="number" min="0"/></div><div class="admin-form__field"><label asp-for="Occasion"></label><input asp-for="Occasion"/></div><div class="admin-form__field admin-product-form__wide"><label asp-for="CareInstructions"></label><textarea asp-for="CareInstructions" rows="3"></textarea></div></div></section>
<section class="admin-product-section"><h2>Variants</h2><p>Add only colors or sizes that are actually available.</p><div data-variants>@for (var i=0;i<Model.Variants.Count;i++){<div class="admin-variant-row" data-variant-index="@i" data-variant-name="@(Model.Variants[i].Name ?? Model.Variants[i].Color ?? Model.Variants[i].Size ?? $"Variant {i+1}")"><input type="hidden" asp-for="Variants[i].Id"/><label>Variant name<input asp-for="Variants[i].Name"/></label><label>Color<input asp-for="Variants[i].Color"/></label><label>Size<input asp-for="Variants[i].Size"/></label><label>SKU<input asp-for="Variants[i].Sku"/></label><label>Price override<input asp-for="Variants[i].PriceOverride" type="number" min="0.01" step="0.01"/></label><label>Stock<input asp-for="Variants[i].StockQuantity" type="number" min="0"/></label><label class="admin-form__field--inline"><input asp-for="Variants[i].IsAvailable"/> Available</label></div>}</div><button type="button" class="button button--outline" data-add-variant>Add variant</button><span asp-validation-for="Variants"></span></section>
<section class="admin-product-section"><h2>Product Images</h2><div class="admin-form__field admin-product-form__wide admin-image-upload"><label asp-for="Images">Upload product images</label><input asp-for="Images" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple data-image-picker/><small>JPEG, PNG or WebP. Maximum 10 MB each. Use the preview controls to select a primary image.</small><div class="admin-image-preview-grid" data-image-previews></div><input asp-for="PrimaryNewImageIndex" type="hidden" data-primary-new-image/></div>
@if (editModel?.ExistingImages.Count > 0) { <div class="admin-form__field admin-product-form__wide"><label>Saved images</label><div class="admin-existing-image-grid">@for (var i=0;i<editModel.ExistingImages.Count;i++){var image=editModel.ExistingImages[i];<div class="admin-existing-image"><img src="@image.UrlOrStorageKey" alt="@(image.AltText ?? "Product image")"/><input type="hidden" name="ExistingImages[@i].Id" value="@image.Id"/><label>Alt text<input name="ExistingImages[@i].AltText" value="@image.AltText" maxlength="180"/></label><label>Order<input name="ExistingImages[@i].SortOrder" value="@image.SortOrder" type="number" min="0"/></label><label>Variant<select name="ExistingImages[@i].ProductVariantId"><option value="">Product gallery</option>@foreach(var variant in Model.Variants.Where(v=>v.Id.HasValue)){<option value="@variant.Id" selected="@(image.ProductVariantId==variant.Id)">@(variant.Name ?? variant.Color ?? variant.Size)</option>}</select></label><label><input type="radio" name="PrimaryExistingImageId" value="@image.Id" checked="@image.IsPrimary"/> Primary</label><label><input type="checkbox" name="ExistingImages[@i].Remove" value="true"/> Remove</label></div>}</div></div> }</section>
<section class="admin-product-section"><h2>Shipping, Returns &amp; Warranty</h2><div class="admin-product-form__grid"><div class="admin-form__field admin-product-form__wide"><label asp-for="PackageContents"></label><textarea asp-for="PackageContents" rows="2"></textarea></div><div class="admin-form__field"><label asp-for="ShippingPolicyReference"></label><input asp-for="ShippingPolicyReference"/></div><div class="admin-form__field admin-product-form__wide"><label asp-for="ShippingInformation"></label><textarea asp-for="ShippingInformation" rows="2"></textarea></div><div class="admin-form__field"><label asp-for="ReturnPolicyReference"></label><input asp-for="ReturnPolicyReference"/></div><div class="admin-form__field admin-product-form__wide"><label asp-for="ReturnInformation"></label><textarea asp-for="ReturnInformation" rows="2"></textarea></div><div class="admin-form__field admin-product-form__wide"><label asp-for="WarrantyInformation"></label><textarea asp-for="WarrantyInformation" rows="2"></textarea></div></div></section>
<section class="admin-product-section"><h2>SEO &amp; Visibility</h2><div class="admin-product-form__grid"><div class="admin-form__field"><label asp-for="SeoTitle"></label><input asp-for="SeoTitle"/></div><div class="admin-form__field admin-product-form__wide"><label asp-for="SeoMetaDescription"></label><textarea asp-for="SeoMetaDescription" rows="2"></textarea></div><div class="admin-form__field admin-product-form__checkbox"><input asp-for="IsFeatured"/><label asp-for="IsFeatured"></label></div><div class="admin-form__field admin-product-form__checkbox"><input asp-for="IsPublished"/><label asp-for="IsPublished"></label></div></div></section>
