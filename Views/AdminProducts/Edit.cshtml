@model AARCHIZZ.Models.AdminProductEditViewModel
@{ ViewData["Title"] = "Edit product"; var categories = ViewBag.Categories as IReadOnlyList<AARCHIZZ.Data.Entities.Category> ?? []; }
<main class="admin-products-page"><div class="container admin-products"><a class="admin-auth-back" asp-action="Index">&larr; Back to products</a><section class="admin-create-panel"><p class="eyebrow">Catalogue management</p><h1>Edit product</h1><p class="admin-auth-intro">Update catalogue details; blank optional fields remain hidden on the storefront. <a asp-controller="AdminCategories" asp-action="Index">Manage categories</a></p>
@if(!categories.Any(category=>category.IsPublished)){<div class="admin-form__error" role="status">No published categories are available. The existing category remains selectable. <a asp-controller="AdminCategories" asp-action="Index">Open Category Management</a></div>}
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-product-form"><input asp-for="Id" type="hidden"/><partial name="_ProductForm" model="Model"/><button class="button button--dark admin-form__submit" type="submit">Save changes <span aria-hidden="true">&rarr;</span></button></form></section></div></main>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/admin-images.js" asp-append-version="true"></script><script src="~/js/admin-variants.js" asp-append-version="true"></script> }
